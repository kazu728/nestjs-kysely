{
  "compilerOptions": {
    "lib": [
      "deno.window"
    ],
    "strict": true
  },
  "lint": {
    "include": [
      "src"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-implicit-any",
        "no-explicit-any",
        "require-await",
        "ban-ts-comment"
      ]
    }
  },
  "fmt": {
    "include": [
      "src",
      "deno.jsonc"
    ]
  }
}
