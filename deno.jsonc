{
  "lint": {
    "include": [
      "src",
      "example/src"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any",
        "require-await",
        "ban-ts-comment",
        "no-sloppy-imports"
      ]
    }
  },
  "fmt": {
    "include": [
      "src",
      "example/src",
      "deno.jsonc"
    ]
  }
}
