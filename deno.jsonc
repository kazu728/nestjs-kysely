{
  "lint": {
    "include": [
      "src",
      "example/src",
      "test"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any",
        "no-sloppy-imports"
      ]
    }
  },
  "fmt": {
    "include": [
      "src",
      "example/src",
      "test",
      "deno.jsonc"
    ]
  }
}
