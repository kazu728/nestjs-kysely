{
  "name": "nestjs-kysely",
  "version": "3.1.5",
  "description": "Kysely module for NestJS",
  "keywords": [
    "kysely",
    "nestjs"
  ],
  "bugs": "https://github.com/kazu728/nestjs-kysely/issues",
  "license": "MIT",
  "author": "kazu728",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazu728/nestjs-kysely"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:package": "sh test/package/run.sh",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.8",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "kysely": ">=0.28 <1"
  },
  "engines": {
    "node": ">=24"
  }
}
