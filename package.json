{
  "name": "nestjs-kysely",
  "version": "3.1.5",
  "description": "Kysely module for NestJS",
  "keywords": [
    "kysely",
    "nestjs"
  ],
  "author": "kazu728",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazu728/nestjs-kysely"
  },
  "bugs": "https://github.com/kazu728/nestjs-kysely/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "format": "deno fmt -c deno.jsonc",
    "format:check": "deno fmt --check -c deno.jsonc",
    "lint": "deno lint -c deno.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:package": "node test/package/require.cjs && node test/package/import.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "kysely": "0.x",
    "reflect-metadata": "^0.1.13 || ^0.2.2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
